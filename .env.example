# ---- App ----
ENVIRONMENT=development
APP_NAME=Gauge

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://gauge:gauge_dev_password@localhost:5555/gauge

# ---- Redis ----
# Internal Docker network uses port 6379; host machine uses 6380 (see docker-compose.yml)
REDIS_URL=redis://redis:6379/0

# ---- JWT / Auth ----
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# ---- Email (Nodemailer/FastAPI-Mail) ----
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@gauge.dev
MAIL_SERVER=smtp.mailtrap.io
MAIL_PORT=587

# ---- LLM Provider API Keys ----
ANTHROPIC_API_KEY=your_anthropic_key
OPENAI_API_KEY=your_openai_key
GOOGLE_API_KEY=your_google_key

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_EVAL_RUNS_FREE_TIER_PER_DAY=20

# ---- GitHub App (for CI/CD integration, added later) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./keys/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# ---- Sentry (added later, Phase 7) ----
SENTRY_DSN=
